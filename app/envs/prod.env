# ─────────────────────────────────────────────────────────────────────────────
#  Authent — Configuración de producción
#  Dominio: https://authent.atharix.com
#
#  Este archivo contiene overrides NO-SECRETOS del entorno de producción.
#  Los valores secretos (SECRET_KEY, DB_PASSWORD, RESEND_API_KEY, etc.)
#  deben ir en el .env raíz (ignorado por git, inyectado en el servidor).
# ─────────────────────────────────────────────────────────────────────────────

# ── Entorno ───────────────────────────────────────────────────────────────────
ENVIRONMENT=prod

# ── Dominio y hosts permitidos ────────────────────────────────────────────────
ALLOWED_HOSTS=authent.atharix.com,localhost,127.0.0.1

# ── CORS (solo el dominio de los clientes que consumen la API) ────────────────
# Añadir aquí cada frontend/app que haga peticiones a la API
CORS_ALLOWED_ORIGINS=https://authent.atharix.com

# ── CSRF ─────────────────────────────────────────────────────────────────────
CSRF_TRUSTED_ORIGINS=https://authent.atharix.com

# ── WebAuthn / Passkeys ───────────────────────────────────────────────────────
# RP ID = dominio de la web app (donde corre la ceremonia en el navegador),
# NO el de esta API. Cambiarlo invalida todos los passkeys existentes.
#
# Es el dominio PADRE, no el de un producto, y eso es deliberado: WebAuthn exige
# que el rpId sea sufijo registrable del origen, así que con `atlas.atharix.com`
# el navegador RECHAZA la ceremonia en metis.atharix.com — y en cualquier otro
# producto del suite. Con `atharix.com`, una sola passkey vale para Atlas, Metis
# y lo que venga, que es justo la promesa de tener una identidad compartida.
#
# ORIGINS sí es la lista exacta de webs que pueden correr la ceremonia: es la
# frontera de seguridad real (el rpId dice "para qué dominio", los origins dicen
# "quién puede pedirlo"). Añade aquí cada producto nuevo.
WEBAUTHN_RP_ID=atharix.com
WEBAUTHN_RP_NAME=Atharix
WEBAUTHN_ORIGINS=https://atlas.atharix.com,https://metis.atharix.com

# ── Seguridad HTTPS ───────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ── Email ─────────────────────────────────────────────────────────────────────
# Usar backend de Resend en producción.
# La API key se define en .env: RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_BACKEND=resend
DEFAULT_FROM_EMAIL=Atharix Auth <noreply@atharix.com>

# ── Base de datos ──────────────────────────────────────────────────────────────
# Ajustar según el servidor de producción.
# DB_PASSWORD se define en .env raíz.
DB_HOST=db
DB_PORT=5432
DB_NAME=authent_db
DB_USER=authent_user
DB_CONN_MAX_AGE=600

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6379

# ── Celery ──────────────────────────────────────────────────────────────────
# Sin estas vars Celery cae a amqp://localhost (sin RabbitMQ) → Connection
# refused en cualquier .delay(), lo que devolvía 500 al crear Business.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Almacenamiento S3 ─────────────────────────────────────────────────────────
# Activar S3 en producción para servir media files.
# Las credenciales se definen en .env raíz.
USE_S3=True
AWS_S3_REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID         → en .env raíz
# AWS_SECRET_ACCESS_KEY     → en .env raíz
# AWS_STORAGE_BUCKET_NAME   → en .env raíz

# ── Puerto expuesto por nginx ──────────────────────────────────────────────────
# HTTP y HTTPS se mapean fijo en docker-compose (80 y 443)
WEB_PORT=80

# ── Atlas Bridge (CRM) ────────────────────────────────────────────────────────
# API key (secreto) se inyecta en el .env del servidor desde CI
# (GitHub Actions secret: ATLAS_BRIDGE_API_KEY).
ATLAS_BRIDGE_BASE_URL=https://atlas.atharix.com
ATLAS_BRIDGE_ENABLED=True
ATLAS_BRIDGE_TIMEOUT=10.0
ATLAS_BRIDGE_MAX_RETRIES=3
