# ─────────────────────────────────────────────
#  Authent — Sobreescrituras para entorno dev
#  Cargado junto con .env cuando ENVIRONMENT=dev
# ─────────────────────────────────────────────

# En desarrollo se permite cualquier origen CORS
CORS_ALLOW_ALL_ORIGINS=True

# Backend de correo en dev. Cambiar a "console" para volver a imprimir
# los emails en stdout en lugar de enviarlos vía Resend.
EMAIL_BACKEND=resend
