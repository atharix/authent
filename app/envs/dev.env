# ─────────────────────────────────────────────
#  Authent — Sobreescrituras para entorno dev
#  Cargado junto con .env cuando ENVIRONMENT=dev
# ─────────────────────────────────────────────

# En desarrollo se permite cualquier origen CORS
CORS_ALLOW_ALL_ORIGINS=True

# ── WebAuthn / Passkeys (dev) ─────────────────────────────────────────────────
# RP ID = host del navegador (sin puerto). El ORIGEN sí lleva puerto y debe
# coincidir EXACTO con donde corre la web (Expo web). Ajustar si cambia el puerto.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:18002,http://localhost:8081,http://localhost:8030

# Backend de correo en dev. Cambiar a "console" para volver a imprimir
# los emails en stdout en lugar de enviarlos vía Resend.
EMAIL_BACKEND=resend

# ── Atlas Bridge (CRM) ────────────────────────────────────────────────────────
# API key (secreto) viene del .env raíz. Resto es configuración pública.
ATLAS_BRIDGE_BASE_URL=http://localhost:8001
ATLAS_BRIDGE_ENABLED=True
ATLAS_BRIDGE_TIMEOUT=10.0
ATLAS_BRIDGE_MAX_RETRIES=3
